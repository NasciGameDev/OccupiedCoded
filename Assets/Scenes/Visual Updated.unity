  dialogue:
    dialogueLines:
    - character:
        name: You
        icon: {fileID: 21300000, guid: a97564652b0cfe548a2b0164b7ebdb1a, type: 3}
      line: I.. I.. I'll come back to help you!
    - character:
        name: You
        icon: {fileID: 21300000, guid: 3fc502bd435f7a1459a2ea83e12d85b5, type: 3}
      line: probably...
    - character:
        name: You
        icon: {fileID: 21300000, guid: a97564652b0cfe548a2b0164b7ebdb1a, type: 3}
      line: This should be the safe key, that ma... thing, or whatever it is must
        have got it and hidden it with the familly.
    - character:
        name: You
        icon: {fileID: 21300000, guid: 3fc502bd435f7a1459a2ea83e12d85b5, type: 3}
      line: Im.. sorry...
  OnDialogueTriggered:
    m_PersistentCalls:
